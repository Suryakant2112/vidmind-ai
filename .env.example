# =============================================================================
# VidMind AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Configuration ---
# Get a free API key from https://console.groq.com
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Embedding Model ---
# Runs locally on CPU — no API key needed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG Settings ---
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Limits ---
MAX_VIDEO_DURATION_MINUTES=120

# --- Storage ---
CHROMA_DB_PATH=./chroma_db
CACHE_DIR=./cache

# --- YouTube Cookies (required for cloud deployment) ---
# Export cookies from your browser using "Get cookies.txt LOCALLY" extension
# YouTube blocks cloud IPs — cookies make requests appear as a logged-in user
# Leave empty if running locally (not needed on your own machine)
COOKIE_PATH=./cookies.txt
