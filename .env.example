# =============================================================================
# VidMind AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Providers (tried in this order; providers without a key are skipped) ---
# 1 + 2. Groq — free key at https://console.groq.com
#        Limits are per model, so the fallback model adds a second free daily quota.
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# 3. Gemini — free key at https://aistudio.google.com (optional)
#    Note: Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Embedding Model (FastEmbed, runs locally on CPU — no API key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./.model_cache

# --- Vector Database (Qdrant) ---
# Leave QDRANT_URL empty to use a local embedded database at QDRANT_PATH.
# For deployment, create a free cluster at https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data

# --- RAG Settings ---
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Limits ---
MAX_VIDEO_DURATION_MINUTES=120
